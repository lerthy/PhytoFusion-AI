# Backend only. Never expose the service role key to the frontend.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Frontend (read-only access, enforced by row-level security)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
# Embeddings for literature search (any OpenAI-compatible /embeddings endpoint).
# The model must return 1536-dimensional vectors, matching vector(1536) in the schema.
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Optional AI explanations. Without a key the app works the same and the
# "Explain in plain words" buttons say AI is not switched on.
# Free option: a Groq key from console.groq.com/keys (the defaults below point at Groq).
AI_API_KEY=
# AI_MODEL=openai/gpt-oss-120b
# AI_BASE_URL=https://api.groq.com/openai/v1
# Or use Claude instead (console.anthropic.com):
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
